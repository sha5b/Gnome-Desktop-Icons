<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.gnome-desktop-icons.IconSize">
    <value nick="small" value="0"/>
    <value nick="standard" value="1"/>
    <value nick="large" value="2"/>
  </enum>

  <schema id="org.gnome.shell.extensions.gnome-desktop-icons"
          path="/org/gnome/shell/extensions/gnome-desktop-icons/">
    <key name="icon-size" enum="org.gnome.shell.extensions.gnome-desktop-icons.IconSize">
      <default>'standard'</default>
      <summary>Icon size</summary>
      <description>Size of the icons drawn on the desktop.</description>
    </key>
    <key name="show-hidden" type="b">
      <default>false</default>
      <summary>Show hidden files</summary>
      <description>Draw files whose name starts with a dot.</description>
    </key>
    <key name="show-home" type="b">
      <default>true</default>
      <summary>Show the Home folder</summary>
      <description>Draw an icon for the user's home folder.</description>
    </key>
    <key name="show-trash" type="b">
      <default>true</default>
      <summary>Show the wastebasket</summary>
      <description>Draw an icon for the wastebasket, full or empty.</description>
    </key>
    <key name="show-volumes" type="b">
      <default>true</default>
      <summary>Show mounted volumes</summary>
      <description>Draw an icon for each mounted drive.</description>
    </key>
  </schema>
</schemalist>
